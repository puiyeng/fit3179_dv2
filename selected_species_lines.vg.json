{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/top_species_month_2025.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "common_name",
        "oneOf": [
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Superb Fairy-wren",
          "Galah"
        ]
      }
    },
    {
      "filter": "Species_selection == null || datum.common_name == Species_selection"
    },
    {
      "filter": "datum.month <= Playback_month"
    }
  ],
  "encoding": {
    "x": {
      "field": "month_name",
      "type": "ordinal",
      "sort": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug"
      ],
      "title": "Month in 2025",
      "scale": {
        "domain": [
          "Jan",
          "Feb",
          "Mar",
          "Apr",
          "May",
          "Jun",
          "Jul",
          "Aug"
        ]
      },
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "sightings_per_10000",
      "type": "quantitative",
      "title": "Sightings per 10,000 observation records",
      "scale": {
        "zero": false,
        "domain": [
          110,
          280
        ]
      }
    },
    "color": {
      "field": "common_name",
      "type": "nominal",
      "title": "Species",
      "scale": {
        "domain": [
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Superb Fairy-wren",
          "Galah"
        ],
        "range": [
          "#2876ae",
          "#c17b16",
          "#67459b",
          "#9b7900"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "title": null,
        "labelFontSize": 12,
        "symbolSize": 100
      }
    },
    "tooltip": [
      {
        "field": "common_name",
        "type": "nominal",
        "title": "Species"
      },
      {
        "field": "month_name",
        "type": "ordinal",
        "title": "Month"
      },
      {
        "field": "sightings_per_10000",
        "type": "quantitative",
        "title": "Per 10,000 records",
        "format": ".1f"
      },
      {
        "field": "sightings",
        "type": "quantitative",
        "title": "Observation records",
        "format": ","
      }
    ]
  },
  "params": [
    {
      "name": "Playback_month",
      "value": 8
    },
    {
      "name": "Species_selection",
      "bind": {
        "input": "select",
        "options": [
          null,
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Superb Fairy-wren",
          "Galah"
        ],
        "labels": [
          "Show all",
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Superb Fairy-wren",
          "Galah"
        ],
        "name": "Species: "
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent",
    "font": "DM Sans",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#46596e",
      "titleColor": "#27364a",
      "gridColor": "#e4e9ef"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#46596e",
      "titleColor": "#27364a"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true
      }
    },
    {
      "transform": [
        {
          "filter": "datum.common_name == 'Superb Fairy-wren' && datum.month == 1 && Playback_month == 8"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "align": "left",
        "dx": 0,
        "dy": 0
      },
      "encoding": {
        "color": {
          "value": "#243b56"
        },
        "text": {
          "value": "Fairy-wren: lower rate in August"
        },
        "tooltip": null,
        "x": {
          "value": 12
        },
        "y": {
          "value": 16
        }
      }
    }
  ]
}
