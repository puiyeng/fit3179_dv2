  "encoding": {
    "x": {
      "field": "state",
      "type": "ordinal",
      "title": "State or territory",
      "sort": [
        "Australian Capital Territory",
        "New South Wales",
        "Northern Territory",
        "Queensland",
        "South Australia",
        "Tasmania",
        "Victoria",
        "Western Australia"
      ],
      "axis": {
        "labelAngle": {
          "expr": "width < 500 ? -90 : 0"
        },
        "labelExpr": "width < 500 ? datum.label : split(datum.label, ' ')",
        "labelLineHeight": 14,
        "labelPadding": 6,
        "labelLimit": 220,
        "labelOverlap": false,
        "labelAlign": {
          "expr": "width < 500 ? 'right' : 'center'"
        },
        "labelBaseline": {
          "expr": "width < 500 ? 'middle' : 'top'"
        }
      }
    },
    "y": {
      "field": "species",
      "type": "nominal",
      "title": null,
      "sort": [
        "Australian Magpie",
        "Rainbow Lorikeet",
        "Superb Fairy-wren",
        "Galah"
      ],
      "axis": {
        "minExtent": 150,
        "labelLimit": 200,
        "labelPadding": 8
      }
    },
    "color": {
      "field": "per_1000",
      "type": "quantitative",
      "title": [
        "Species records per 1,000",
        "state observation records"
      ],
      "scale": {
        "domain": [
          0,
          22.5,
          45
        ],
        "range": [
          "#eef7f7",
          "#8cc9cc",
          "#165b64"
        ],
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 240,
        "titleLimit": 300,
        "values": [
          0,
          15,
          30,
          45
        ],
        "gradientOpacity": 1,
        "title": [
          "Species records per 1,000",
          "state observation records"
        ],
        "titleLineHeight": 14
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "species",
        "type": "nominal",
        "title": "Species"
      },
      {
        "field": "per_1000",
        "type": "quantitative",
        "title": "Species records per 1,000 state records",
        "format": ".2f"
      },
      {
        "field": "species_records",
        "type": "quantitative",
        "title": "Species records",
        "format": ",.0f"
      },
      {
        "field": "state_records",
        "type": "quantitative",
        "title": "State observation records",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent",
    "font": "DM Sans",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#46596e",
      "titleColor": "#27364a",
      "gridColor": "#e4e9ef"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#46596e",
      "titleColor": "#27364a"
    }
  },
  "transform": [
    {
      "filter": {
        "field": "species",
        "oneOf": [
          "Australian Magpie",
          "Rainbow Lorikeet",
          "Superb Fairy-wren",
          "Galah"
        ]
      }
    }
  ],
  "description": "State sighting rates for the same four focus birds as the monthly views, repeated location maps and seasonal connected dot plot.",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": null,
        "opacity": 1
      }
    },
    {
      "name": "state_comparison_cells",
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#243b56",
        "lineBreak": "\n",
        "lineHeight": 14,
        "align": "center",
        "baseline": "middle",
        "font": "DM Sans"
      },
      "encoding": {
        "text": {
          "field": "comparison_cell_label",
          "type": "nominal"
        },
        "description": {
          "field": "comparison_cell_label",
          "type": "nominal"
        },
        "tooltip": null,
        "x": {
          "field": "state",
          "type": "ordinal"
        },
        "y": {
          "field": "species",
          "type": "nominal"
        },
        "color": {
          "value": {
            "expr": "datum.per_1000 > 22.5 ? 'white' : '#243b56'"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.species == 'Rainbow Lorikeet' && indexof(['New South Wales', 'Tasmania'], datum.state) >= 0"
        },
        {
          "calculate": "format(datum.per_1000, '.2f')",
          "as": "comparison_cell_label"
        }
      ]
    }
  ]
}
