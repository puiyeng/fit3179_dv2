    {
      "transform": [
        {
          "filter": "indexof(['Rainbow Lorikeet', 'Superb Fairy-wren'], datum.species) >= 0"
        },
        {
          "calculate": "'Winter: ' + format(abs(datum.winter_rate / datum.summer_rate - 1), '.0%') + (datum.winter_rate < datum.summer_rate ? ' lower' : ' higher') + '\\nrecording rate'",
          "as": "period_change"
        }
      ],
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.species == 'Superb Fairy-wren' ? 'left' : 'right'"
        },
        "baseline": "bottom",
        "dx": {
          "expr": "datum.species == 'Superb Fairy-wren' ? 10 : -10"
        },
