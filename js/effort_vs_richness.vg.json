  "transform": [
    {
      "calculate": "{\"Australian Capital Territory\": \"Australian Capital\\nTerritory\", \"New South Wales\": \"New South\\nWales\", \"Northern Territory\": \"Northern\\nTerritory\", \"Queensland\": \"Queensland\", \"South Australia\": \"South\\nAustralia\", \"Tasmania\": \"Tasmania\", \"Victoria\": \"Victoria\", \"Western Australia\": \"Western\\nAustralia\"}[datum.state]",
      "as": "state_label"
    },
    {
      "calculate": "datum.state == 'Tasmania' ? datum.raw_recorded_richness : 0",
      "as": "tasmania_richness"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "tasmania_richness",
          "as": "tasmania_richness"
        },
        {
          "op": "sum",
          "field": "total_records",
          "as": "all_records"
        }
      ]
    },
    {
      "calculate": "Scatter_state != null ? datum.state_label + '\\n' + format(datum.total_records / datum.all_records, '.1%') + ' of mapped records' : datum.state == 'Northern Territory' ? 'Northern Territory: ' + format(datum.raw_recorded_richness - datum.tasmania_richness, ',.0f') + ' more species\\nthan Tasmania, with fewer records.' : datum.state_label",
      "as": "state_label"
    }
  ],
