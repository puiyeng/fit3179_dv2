{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/state_richness_100k.csv",
    "format": {
      "type": "csv",
      "parse": {
        "mean_richness_100k": "number",
        "p05_richness_100k": "number",
        "p95_richness_100k": "number",
        "total_records": "number",
        "raw_recorded_richness": "number"
      }
    }
  },
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "key": "properties.STE_NAME26"
      },
      "as": "geo"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent",
    "font": "DM Sans",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#46596e",
      "titleColor": "#27364a",
      "gridColor": "#e4e9ef"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#46596e",
      "titleColor": "#27364a"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "opacity": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "mean_richness_100k",
          "type": "quantitative",
          "title": "Mean species in 100,000 records",
          "scale": {
            "domain": [
              220,
              380,
              540
            ],
            "range": [
              "#f4e9b9",
              "#a6cf9c",
              "#25684d"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 190,
            "title": "Mean species in 100,000 records",
            "labelFontSize": 12,
            "titleLimit": 400,
            "gradientOpacity": 1
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "mean_richness_100k",
            "type": "quantitative",
            "title": "Mean species in 100,000 records",
            "format": ".1f"
          },
          {
            "field": "p05_richness_100k",
            "type": "quantitative",
            "title": "Lower end of sample range (5th percentile)",
            "format": ".1f"
          },
          {
            "field": "p95_richness_100k",
            "type": "quantitative",
            "title": "Upper end of sample range (95th percentile)",
            "format": ".1f"
          },
          {
            "field": "total_records",
            "type": "quantitative",
            "title": "State observation records",
            "format": ",.0f"
          },
          {
            "field": "raw_recorded_richness",
            "type": "quantitative",
            "title": "Distinct recorded species",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "name": "named_state_richness",
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "color": {
          "expr": "datum.mean_richness_100k >= 480 ? 'white' : '#243b56'"
        },
        "lineBreak": "\n",
        "lineHeight": 14,
        "align": "center",
        "baseline": "middle",
        "font": "DM Sans"
      },
      "encoding": {
        "text": {
          "field": "map_richness_label",
          "type": "nominal"
        },
        "description": {
          "field": "map_richness_label",
          "type": "nominal"
        },
        "tooltip": null,
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "filter": {
            "field": "state",
            "oneOf": [
              "Queensland",
              "New South Wales"
            ]
          }
        },
        {
          "calculate": "datum.state == 'Queensland' ? 144.5 : 147",
          "as": "label_longitude"
        },
        {
          "calculate": "datum.state == 'Queensland' ? -23 : -32.3",
          "as": "label_latitude"
        },
        {
          "calculate": "datum.state + '\\n' + format(datum.mean_richness_100k, '.1f') + ' species'",
          "as": "map_richness_label"
        }
      ]
    }
  ]
}
