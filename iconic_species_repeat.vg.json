{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "repeat": [
    "Australian Magpie",
    "Rainbow Lorikeet",
    "Superb Fairy-wren",
    "Galah"
  ],
  "columns": 2,
  "spec": {
    "width": 500,
    "height": 429,
    "projection": {
      "type": "mercator",
      "center": [
        133,
        -27
      ],
      "scale": 528.5714285714286,
      "translate": [
        250,
        228.57142857142858
      ]
    },
    "layer": [
      {
        "data": {
          "url": "data/states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "mark": {
          "type": "geoshape",
          "fill": "#eef0eb",
          "stroke": "#91a294",
          "strokeWidth": 0.6
        }
      },
      {
        "data": {
          "url": "data/iconic_species_dots_wide_2025.csv"
        },
        "mark": {
          "type": "circle",
          "opacity": 0.8
        },
        "encoding": {
          "longitude": {
            "field": "longitude",
            "type": "quantitative"
          },
          "latitude": {
            "field": "latitude",
            "type": "quantitative"
          },
          "size": {
            "field": {
              "repeat": "repeat"
            },
            "type": "quantitative",
            "scale": null,
            "legend": null
          },
          "color": {
            "field": "species",
            "type": "nominal",
            "scale": {
              "domain": [
                "Australian Magpie",
                "Rainbow Lorikeet",
                "Superb Fairy-wren",
                "Galah"
              ],
              "range": [
                "#2876ae",
                "#c17b16",
                "#67459b",
                "#9b7900"
              ]
            },
            "legend": null
          },
          "tooltip": [
            {
              "field": "species",
              "type": "nominal",
              "title": "Species"
            },
            {
              "field": "longitude",
              "type": "quantitative",
              "title": "Sampled record longitude",
              "format": ".2f"
            },
            {
              "field": "latitude",
              "type": "quantitative",
              "title": "Sampled record latitude",
              "format": ".2f"
            }
          ]
        }
      },
      {
        "data": {
          "values": [
            {
              "Australian Magpie": "Australian Magpie",
              "Rainbow Lorikeet": "Rainbow Lorikeet",
              "Superb Fairy-wren": "Superb Fairy-wren",
              "Galah": "Galah"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "top",
          "x": 250,
          "y": 5,
          "fontSize": 14,
          "fontWeight": "bold"
        },
        "encoding": {
          "text": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent",
    "font": "DM Sans",
    "concat": {
      "spacing": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "labelColor": "#46596e",
      "titleColor": "#27364a",
      "gridColor": "#e4e9ef"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#46596e",
      "titleColor": "#27364a"
    }
  }
}
